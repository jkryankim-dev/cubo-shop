# =====================================================================
# CUBO Shop 환경변수 — 실제 값은 .env.local 에 채워 넣으세요
# .env.local 은 .gitignore 로 절대 커밋되지 않습니다.
# =====================================================================

# ---------------------------------------------------------------------
# Firebase Web SDK (클라이언트 — NEXT_PUBLIC_ 접두사라 브라우저에 노출됨)
# 위치: Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱 > 웹 앱 SDK 구성
# cuboerp 와 동일한 Firebase 프로젝트 값을 그대로 사용
# ---------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------
# Firebase Admin SDK (서버 전용 — 절대 NEXT_PUBLIC_ 붙이지 말 것)
# 위치: Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
# 다운로드한 JSON 의 값들을 아래 3개에 매핑
# private_key 는 줄바꿈을 \n 으로 그대로 두고 따옴표로 감싸세요
# ---------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ---------------------------------------------------------------------
# 결제 PG — 토스페이먼츠 (TossPayments)
# 위치: 토스페이먼츠 개발자센터 > 내 상점 > API 키
# 운영용 키는 심사 통과 후 발급됨. 그 전까지는 테스트 키로 동작.
# ---------------------------------------------------------------------
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 보안 키 — 가상계좌 입금 알림 등 토스 → 우리 webhook 서명 검증용.
# 현재(카드 결제만) 미사용이지만, 추후 webhook 도입 시 즉시 활성화 가능.
TOSS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# ERP 동기화 webhook
# cubo-shop 결제 확정 직후 cuboerp 의 sync 엔드포인트를 한 번 호출합니다.
# 이게 cubo-shop → ERP 자동 반영의 단일 진입점이에요.
# 호출 실패해도 결제 결과에는 영향 없음.
# ERP_SYNC_SECRET 의 값은 cuboerp 측 sync 핸들러가 검증하는 값과 일치해야 합니다
# (cuboerp 가 변수명을 CRON_SECRET 등으로 부르더라도 값만 같으면 OK).
# ---------------------------------------------------------------------
ERP_SYNC_URL=https://cubopartners.co.kr/api/shop-orders/sync
ERP_SYNC_SECRET=

# ---------------------------------------------------------------------
# 광고·방문 트래킹 (운영 시작 시 활성화)
# 비어있으면 script 자체 추가 안 함 (no-op).
# ---------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_NAVER_TRACKING_ID=

# ---------------------------------------------------------------------
# Sentry (모니터링)
# DSN 만 채우면 에러 캡처 동작. AUTH_TOKEN+ORG+PROJECT 까지 채우면
# 빌드 시 source map 업로드 활성화 (스택트레이스 보기 좋아짐).
# ---------------------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ---------------------------------------------------------------------
# 팝빌 (카카오 알림톡 — cuboerp 와 동일 계정·발신번호 공유, 쿠보유통 명의 발송)
# 위치: 팝빌 사이트 > 회원관리 > LinkID/SecretKey
# 본문은 등록 템플릿과 글자 단위 일치 必 (lib/alimtalk.ts 의 빌더 함수 참고)
# ---------------------------------------------------------------------
POPBILL_LINKID=CUBO
POPBILL_SECRETKEY=
POPBILL_IS_TEST=false
# Netlify 등 동적 IP 환경에서는 false (IP 화이트리스트 사용 시 true)
POPBILL_IP_RESTRICT=false
# 사전 등록된 발신번호 (cuboerp 와 동일)
POPBILL_SENDER_PHONE=01093192967
# 발송 주체 — 쿠보유통
POPBILL_DISTRIBUTOR_CORPNUM=1708503147
POPBILL_DISTRIBUTOR_USERID=cubo01

# 알림톡 템플릿 코드 (팝빌 콘솔에서 등록·검수 후 받음)
POPBILL_TEMPLATE_PAYMENT_CONFIRMED=
POPBILL_TEMPLATE_VIRTUAL_ACCOUNT_ISSUED=
POPBILL_TEMPLATE_SHIPPED=
POPBILL_TEMPLATE_CANCELLED=
POPBILL_TEMPLATE_REFUNDED=
# 사업자 회원에게 세금계산서 정보 입력 요청 (ERP 측에서 호출 가능, cubo-shop 도 자리 보유)
POPBILL_TEMPLATE_TAX_INFO_REQUEST=
# 배송 완료 알림은 택배사가 발송 — cubo-shop 측 등록·발송 X

# ---------------------------------------------------------------------
# 사업자 정보 (푸터 노출용 — 모두 NEXT_PUBLIC_)
# 발행 주체는 "쿠보유통". 통신판매업번호만 주식회사 쿠보 명의 그대로 유지.
# ---------------------------------------------------------------------
NEXT_PUBLIC_BUSINESS_NAME=쿠보유통
NEXT_PUBLIC_BUSINESS_CEO=조원희
NEXT_PUBLIC_BUSINESS_REG_NO=170-85-03147
NEXT_PUBLIC_BUSINESS_MAIL_ORDER_NO=제2025-충남천안-1814호
NEXT_PUBLIC_BUSINESS_ADDRESS=충청남도 천안시 동남구 서부대로 111
NEXT_PUBLIC_BUSINESS_PHONE=010-4557-4183
NEXT_PUBLIC_BUSINESS_EMAIL=jkryankim@gmail.com

# ---------------------------------------------------------------------
# 사이트 URL (sitemap·robots·메타 OG·canonical 등에 사용)
# ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://cubomall.kr
